<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

    <div class="col-12 col-lg-10 offset-lg-1">

        <h3 class="show-title"><%= listing.title %></h3>

        <img
            src="<%= listing.image.url %>"
            class="show-hero"
            alt="listing_image"
        >

        <div class="row mt-4">

            <!-- Left: details -->
            <div class="col-12 col-lg-7">
                <h5 class="mb-1"><%= listing.location %>, <%= listing.country %></h5>
                <p class="text-muted">Owned By: <i><%= listing.owner.username %></i></p>
                <hr>
                <p class="card-text"><%= listing.description %></p>

                <!--
                    Owner check: jo user abhi login hai, kya wahi is listing ka owner hai?
                    Agar haan, to hi Edit aur Delete buttons dikhte hain.
                -->
                <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
                <div class="btns">
                    <a
                        href="/listings/<%= listing.id %>/edit"
                        class="btn btn-dark edit-btn"
                    >
                        Edit
                    </a>
                    <form
                        method="POST"
                        action="/listings/<%= listing.id %>?_method=DELETE"
                    >
                        <button class="btn btn-dark">
                            Delete
                        </button>
                    </form>
                </div>
                <% } %>
            </div>

            <!-- Right: price card -->
            <div class="col-12 col-lg-5 mt-4 mt-lg-0">
                <div class="price-card">
                    <p class="price-big">&#8377; <%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %> <span>/ night</span></p>
                    <% if(listing.price != null) { %>
                    <p class="text-muted mb-0">Total with 18% GST: &#8377; <%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %></p>
                    <% } %>
                </div>
            </div>

        </div>

    </div>


    <div class="col-12 col-lg-10 offset-lg-1 mb-3">
        <hr>

        <!--Review form sirf logged in user ko dikhega-->
        <% if(currUser) { %>
        <h4>Leave a Review</h4>

        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <input
                    type="range"
                    min="1"
                    max="5"
                    id="rating"
                    name="review[rating]"
                    class="form-range"
                />
            </div>

            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea
                    name="review[comment]"
                    id="comment"
                    rows="5"
                    cols="30"
                    class="form-control"
                    required
                ></textarea>
                <div class="invalid-feedback">
                    Please Share some reviews..
                </div>
            </div>

            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr>
        <% } %>


        <p><b>All Reviews</b></p>
        <div class="row">

            <% for (review of listing.reviews) { %>
            <div class="col-12 col-md-6 mb-3">
                <div class="card review-card">
                    <div class="card-body">
                        <h5 class="card-title">@<%= review.author.username %></h5>
                        <p class="card-text"><%= review.comment %></p>
                        <p class="card-text"><%= review.rating %> stars</p>
                        <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>

        </div>

        <!--Map section (Leaflet + OpenStreetMap)-->
        <hr>
        <h3>Where you'll be</h3>
        <div id="map" style="height: 350px; width: 100%;"></div>
    </div>
</div>

<script>
  const listing = <%- JSON.stringify(listing) %>;

  if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) {
    const lng = listing.geometry.coordinates[0];
    const lat = listing.geometry.coordinates[1];

    const map = L.map("map").setView([lat, lng], 10);

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: "&copy; OpenStreetMap contributors",
    }).addTo(map);

    L.marker([lat, lng])
      .addTo(map)
      .bindPopup("<b>" + listing.title + "</b><br>" + listing.location)
      .openPopup();
  } else {
    document.getElementById("map").innerHTML =
      "<p class='text-muted p-3'>Map not available for this listing. Edit and save it to generate the map.</p>";
  }
</script>